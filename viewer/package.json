{
  "name": "viewer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build-changelog": "node ../scripts/build-changelog.mjs",
    "predev": "pnpm run build-changelog",
    "prebuild": "pnpm run build-changelog",
    "pretypecheck": "pnpm run build-changelog",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "mkdir -p out/cmdt; mv out/* out/cmdt; serve out",
    "lint": "biome check && pnpm typecheck",
    "lint:fix": "biome check --write",
    "format": "biome format",
    "format:fix": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.7",
    "@radix-ui/react-dialog": "^1.1.10",
    "@radix-ui/react-popover": "^1.1.10",
    "@radix-ui/react-scroll-area": "^1.2.5",
    "@radix-ui/react-select": "^2.2.2",
    "@radix-ui/react-separator": "^1.1.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.8",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.15.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "json-edit-react": "^1.29.0",
    "lucide-react": "^0.501.0",
    "next": "15.3.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.2.0",
    "use-file-picker": "^2.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@radix-ui/react-dropdown-menu": "^2.1.11",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.16",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^22.18.12",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/wicg-file-system-access": "^2023.10.7",
    "cmdt-shared": "workspace:*",
    "serve": "14.2.6",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.2.5",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
